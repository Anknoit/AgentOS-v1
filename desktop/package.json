{
  "name": "agentos-desktop",
  "version": "0.0.0",
  "private": true,
  "description": "AgentOS Electron shell — spawns and supervises the FastAPI backend sidecar, connects the renderer to a configurable backend URL over a secure IPC bridge.",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "smoke:sidecar": "tsx scripts/smoke-sidecar.ts",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.3.9",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
