# Copy to backend/.env for local dev. All values have safe defaults; nothing here is required
# to boot (the backend falls back to SQLite + an in-process runtime — see docs/adr/0006).

AGENTOS_ENV=dev

# --- Database ---
# Leave unset (or sqlite) for the zero-dependency dev fallback.
# For the real Postgres path (via infra/docker-compose.yml):
#   AGENTOS_DATABASE_URL=postgresql+asyncpg://agentos:agentos@localhost:5432/agentos
# AGENTOS_DATABASE_URL=sqlite+aiosqlite:///./agentos.db

# --- Redis / workers ---
# Unset => agent runs execute in-process. Set => runs are enqueued to Arq workers.
# AGENTOS_REDIS_URL=redis://localhost:6379/0

# --- Event bus ---
# "inprocess" (default) or "nats". For NATS: AGENTOS_NATS_URL=nats://localhost:4222
# AGENTOS_BUS=inprocess

# --- LLM provider (Phase 0 spike) ---
# "mock" (default, deterministic, no network) or "openai".
AGENTOS_LLM_PROVIDER=mock
# OPENAI_API_KEY=sk-...

# --- Observability ---
# Trace exporter: "console" (default) or "otlp" (needs the obs compose profile).
AGENTOS_OTEL_EXPORTER=console
# AGENTOS_OTLP_ENDPOINT=http://localhost:4318

# --- Server ---
AGENTOS_HOST=127.0.0.1
AGENTOS_PORT=8787

# --- Bootstrap tenant/api-key (dev convenience) ---
# On startup, if the DB is empty, seed this tenant + api key so the client can authenticate.
AGENTOS_SEED_DEV_TENANT=true
AGENTOS_DEV_API_KEY=dev-local-key

# --- Credential vault (Phase 2) ---
# Master secret for per-tenant connector-credential encryption (ADR-0008). A per-tenant key is
# derived from this; MUST be set to a strong random value in prod. Rotating it makes existing
# stored credentials undecryptable (they must be re-entered).
# AGENTOS_SECRET_KEY=change-me-to-a-long-random-string

# --- Payments / settlement (Phase 4) ---
# "mock" (default, in-process gateway that signs with the key secret — full flow, no network) or
# "razorpay" (live Orders API + webhooks). Secrets live here only; never logged or returned.
AGENTOS_PAYMENT_PROVIDER=mock
# AGENTOS_RAZORPAY_KEY_ID=rzp_live_xxx
# AGENTOS_RAZORPAY_KEY_SECRET=change-me
# AGENTOS_RAZORPAY_WEBHOOK_SECRET=change-me
# Gateway currency + its minor-unit scale (USD→cents=100, INR→paise=100) and USD→gateway FX.
# The ledger stays in USD nanodollars; these record what the gateway actually charged.
# AGENTOS_RAZORPAY_CURRENCY=USD
# AGENTOS_RAZORPAY_MINOR_PER_UNIT=100
# AGENTOS_RAZORPAY_FX_USD_TO_GATEWAY=1
# Flip prepaid credit control on after the first successful top-up (entering the payment path).
# AGENTOS_ENFORCE_BALANCE_ON_TOPUP=true

# --- Scale & reliability (Phase 5) ---
# Durable, replayable metering stream (transactional outbox). On by default so `agentos replay`
# and /v1/ops/replay work; the durable log is what a Kafka relay ships at scale.
# AGENTOS_DURABLE_BUS=true
# Event bus: "inprocess" (default), "nats", or "kafka". For Kafka: AGENTOS_KAFKA_BROKERS=host:9092
# AGENTOS_BUS=inprocess
# AGENTOS_KAFKA_BROKERS=localhost:9092
# Fair run scheduling: global in-flight cap (backpressure) + per-tenant cap (anti-starvation).
# AGENTOS_RUN_MAX_CONCURRENCY=8
# AGENTOS_RUN_PER_TENANT_CONCURRENCY=4
# Arq per-tenant queue partition this worker serves (run one worker per partition). See queue.py.
# AGENTOS_WORKER_QUEUE=arq:runs:0
# Multi-provider routing + failover. Candidates are "provider:model"; cheapest healthy one wins and
# the router fails over on a request-time error. Empty => the single AGENTOS_LLM_PROVIDER (default).
# AGENTOS_PROVIDER_FAILOVER=true
# AGENTOS_PROVIDER_CANDIDATES=["openai:gpt-4o-mini","anthropic:claude-haiku-4-5"]
# AGENTOS_PROVIDER_CIRCUIT_THRESHOLD=3
# AGENTOS_PROVIDER_CIRCUIT_COOLDOWN_S=30
# Hot-path rate-card cache TTL (seconds); 0 disables it.
# AGENTOS_RATE_CARD_CACHE_TTL_S=30
# HA/DR: route lag-tolerant reads to a replica (falls back to the primary when unset).
# AGENTOS_READ_REPLICA_URL=postgresql+asyncpg://agentos:agentos@replica:5432/agentos
