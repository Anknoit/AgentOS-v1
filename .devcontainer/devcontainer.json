{
  "name": "AgentOS",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "backend/.venv/bin/python"
      },
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "charliermarsh.ruff"]
    }
  },
  "updateContentCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && cd backend && $HOME/.local/bin/uv venv && $HOME/.local/bin/uv pip install -e '.[dev]' && echo '✅ backend deps installed'",
  "postAttachCommand": {
    "backend": "cd backend && $HOME/.local/bin/uv run agentos serve"
  },
  "portsAttributes": {
    "8787": {
      "label": "AgentOS backend",
      "onAutoForward": "notify"
    }
  },
  "forwardPorts": [8787]
}
